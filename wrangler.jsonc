{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thecahub",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for ISR revalidation; must match "name"
    { "binding": "WORKER_SELF_REFERENCE", "service": "thecahub" }
  ],
  "kv_namespaces": [
    // OpenNext incremental (ISR) cache
    { "binding": "NEXT_INC_CACHE_KV", "id": "6898c2734207452b8f4f94c3ebe2ea47" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
  // 04:00 UTC = 09:00 PKT daily social post (was vercel.json cron)
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true }
}
